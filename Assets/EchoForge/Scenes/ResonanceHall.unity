      m_Calls: []
  m_text: 'EMITTER  releases one visible pulse.

    REFLECTOR  turns the pulse in
    45 steps.

    ABSORBER  stops a pulse.

    SPLITTER  forks one pulse into two.

    DELAY
    PLATE  holds a pulse a set number of beats.

    RECEIVER  needs a pulse. Forbidden
    receivers must stay silent.

    RESONATOR  needs two pulses in the right relationship.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
